{
  "name": "resit-backend",
  "version": "0.1.0",
  "private": true,
  "main": "src/server.js",
  "engines": { "node": ">=18.18" },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "postinstall": "prisma generate",
    "build": "prisma db push --skip-generate && node prisma/seed.js",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.js",
    "setup": "prisma db push && node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "bcryptjs": "2.4.3",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "exceljs": "4.4.0",
    "express": "4.21.2",
    "express-rate-limit": "7.4.1",
    "jsonwebtoken": "9.0.2",
    "multer": "1.4.5-lts.1",
    "pdfkit": "0.15.1",
    "prisma": "5.22.0"
  }
}
