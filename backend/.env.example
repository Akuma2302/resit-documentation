# Copy this file to .env and change the values before real use.

# MongoDB connection string, for example from MongoDB Atlas (https://www.mongodb.com/atlas).
# It must include the database name (here "resit") before the "?".
DATABASE_URL="mongodb+srv://user:password@cluster0.example.mongodb.net/resit?retryWrites=true&w=majority"

# Signs login tokens. Use a long random string.
SESSION_SECRET="change-me-to-a-long-random-string"

# Where the frontend is served from. Comma-separate several origins.
CORS_ORIGIN="http://localhost:5173"

PORT=4000

# Local development only: set to "true" to skip the login page and enter as the first admin.
# Ignored when NODE_ENV is "production". Never set this on a hosted server.
DEV_AUTO_LOGIN="false"

# Accounts created by `npm run setup`. Change the passwords before seeding.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="admin12345"
SEED_STAFF_EMAIL="staff@example.com"
SEED_STAFF_PASSWORD="staff12345"
