# Copy this file to .env and change the values before real use.

# PostgreSQL connection string, for example from Neon (https://neon.tech).
# On Netlify this is not needed when Netlify DB is added to the site.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Signs the login cookie. Use a long random string.
SESSION_SECRET="change-me-to-a-long-random-string"

# Accounts created by `npm run setup`. Change the passwords after first login
# (Admin > Settings > Users) or before seeding.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="admin12345"
SEED_STAFF_EMAIL="staff@example.com"
SEED_STAFF_PASSWORD="staff12345"
